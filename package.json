{
  "name": "hopnshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:android": "vite build --configLoader runner",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
